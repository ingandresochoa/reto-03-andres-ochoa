# Proveedor LLM (Groq, API compatible con OpenAI)
# Nunca subas el .env al repositorio.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Servidor
PORT=3000

# Límites de costo
MAX_ITERATIONS=25
MAX_TOKENS_PER_SESSION=120000

# Timeout de una llamada al proveedor LLM (milisegundos)
LLM_TIMEOUT_MS=30000

# Fecha fija opcional para hacer la demo determinista (YYYY-MM-DD).
# Si está vacía se usa la fecha del sistema.
DEMO_FECHA=
